# Copiez ce fichier en .env (ou exportez ces variables) avant le lancement.
PORT=3001
# Postgres hébergé (Neon). Laisser vide en local : PGlite est utilisé.
# DATABASE_URL=postgres://...
# Dossier de la base PGlite locale
DATABASE_PATH=./data/pglite
# Compte administrateur créé au premier lancement — CHANGEZ le mot de passe
ADMIN_EMAIL=admin@descogef.local
ADMIN_PASSWORD=ChangezMoi-2026!
# Durée de validité des sessions (jours)
SESSION_DAYS=30
# Origine autorisée si l'interface est servie depuis un autre domaine (optionnel)
# APP_ORIGIN=https://revision.exemple.org
