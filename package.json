{
  "name": "descogef-revision",
  "version": "0.1.0",
  "private": true,
  "description": "Application de révision pour le DESCOGEF (espace OHADA/UEMOA)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "seed:reset": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
